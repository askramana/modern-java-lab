# Lombok configuration for this project. Lombok reads the nearest lombok.config walking up from each source file;
# stopBubbling keeps settings from parent folders out of this project.
config.stopBubbling = true

# @NonNull on record components, constructor and method parameters throws this type.
# Options: NullPointerException (default), IllegalArgumentException, JDK (uses Objects.requireNonNull), Guava, Assertion.
# NPE is the right signal: a null argument is a caller bug, not bad input.
lombok.nonNull.exceptionType = NullPointerException

# Marks generated members with @lombok.Generated so coverage tools (JaCoCo) skip them.
lombok.addLombokGeneratedAnnotation = true
